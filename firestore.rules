rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Suma 1 a un contador de estadísticas (visitas o clics) en un anuncio activo.
    function inc(f) {
      return resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([f])
        && request.resource.data[f] == resource.data.get(f, 0) + 1;
    }

    // Para saber si eres administrador. Solo puedes leer tu propio documento.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Precios, cupos y promoción: los ve todo el mundo, solo los cambia un administrador.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Directorio de anuncios.
    match /ads/{id} {
      allow read: if resource.data.active == true
        || (signedIn() && (resource.data.uid == request.auth.uid || isAdmin()));
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientArchived']))
        || inc('views') || inc('clicksWhatsapp') || inc('clicksPhone') || inc('clicksEmail') || inc('clicksWeb');
    }

    // Reportes de anuncios: cualquier visitante puede enviar uno; solo el administrador los lee y resuelve.
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['adId', 'brand', 'reason', 'note', 'contact', 'status', 'createdAt', 'uid'])
        && request.resource.data.status == 'nuevo'
        && request.resource.data.adId is string && request.resource.data.adId.size() <= 40
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 80
        && request.resource.data.brand.size() <= 60
        && request.resource.data.note.size() <= 300
        && request.resource.data.contact.size() <= 60
        && request.resource.data.createdAt is number
        && request.resource.data.uid == (signedIn() ? request.auth.uid : '');
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Avisos y solicitudes de cambio. El administrador avisa a clientes; el cliente solo puede pedir cambios al administrador.
    match /notices/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        || (signedIn() && request.auth.token.email_verified == true
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.dir == 'admin'
            && request.resource.data.kind in ['cambio', 'baja']
            && request.resource.data.status == 'nuevo'
            && request.resource.data.keys().hasOnly(['uid', 'userEmail', 'dir', 'kind', 'adId', 'brand', 'subject', 'text', 'newOffer', 'newText', 'media', 'status', 'at', 'read', 'adminRead'])
            && request.resource.data.text.size() <= 500
            && request.resource.data.get('newText', '').size() <= 300
            && request.resource.data.get('newOffer', '').size() <= 20
            && (request.resource.data.get('media', null) == null || request.resource.data.media.url.size() < 240000));
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'archivedClient']));
      allow delete: if false;
    }

    // Pedidos (solicitudes). Cada cuenta crea las suyas y ve solo las suyas.
    // El monto lo fija el administrador al aceptar; lo que el anunciante envíe como monto es solo un estimado.
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'revision'
        && request.resource.data.designPieces is int && request.resource.data.designPieces >= 0 && request.resource.data.designPieces <= 5
        && request.resource.data.keys().hasOnly(['uid', 'userEmail', 'status', 'createdAt', 'tier', 'renewOf', 'designPieces', 'designBrief',
            'usePromo', 'brand', 'headline', 'body', 'legalName', 'docId', 'categoria', 'cats', 'offer', 'hours', 'localidad', 'barrio', 'address', 'whatsapp', 'phone', 'mail', 'web',
            'pal', 'media', 'media2', 'amount', 'days'])
        && request.resource.data.days in [1, 3, 7, 14, 30]
        && request.resource.data.brand.size() <= 60
        && request.resource.data.headline.size() <= 80
        && request.resource.data.body.size() <= 300
        && request.resource.data.get('cats', []).size() <= 3
        && request.resource.data.get('offer', '').size() <= 20
        && request.resource.data.get('legalName', '').size() <= 80
        && request.resource.data.get('docId', '').size() <= 20
        && request.resource.data.get('hours', '').size() <= 80
        && (request.resource.data.media == null || request.resource.data.media.url.size() < 420000)
        && (request.resource.data.get('media2', null) == null || request.resource.data.media2.url.size() < 240000);
      // El anunciante solo puede avisar que ya pagó. El administrador puede cambiarlo todo.
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.status == 'por_pagar'
            && request.resource.data.status == 'pago_reportado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reportedAt']))
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientArchived']))
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.get('contractStatus', '') == ''
            && request.resource.data.contractStatus == 'solicitado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contractStatus', 'contractRequestedAt']));
      allow delete: if false;
    }
  }
}
